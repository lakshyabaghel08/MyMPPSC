{
  "name": "mymppsc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first MPPSC Prelims preparation app (PYQ simulations, topic practice, smart practice, mistake book, adaptive revision, analytics, syllabus planner). No build step: the app is plain HTML/CSS/ES modules.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:verbose": "node --test --test-reporter=spec tests/*.test.js",
    "serve": "node tools/serve.mjs",
    "check": "node tools/check.mjs",
    "audit:ui": "node tools/check.mjs",
    "audit:visual": "node tools/visual-audit.mjs",
    "capture:visual": "node tools/capture-visual.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
